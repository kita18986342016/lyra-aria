{
  "name": "lyra-aria",
  "productName": "深空折韵",
  "version": "1.3.6",
  "description": "深空折韵 · Lyra Aria —— 本地音乐播放器（DSH 制作）",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win dir"
  },
  "author": "DSH",
  "license": "MIT",
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "koffi": "^3.1.5",
    "music-metadata": "^11.14.0",
    "node-id3": "^0.2.9"
  },
  "build": {
    "appId": "com.lyraaria.musicplayer",
    "productName": "深空折韵",
    "directories": {
      "output": "dist"
    },
    "electronDist": "node_modules/electron/dist",
    "files": [
      "main.js",
      "preload.js",
      "core/**",
      "renderer/**",
      "assets/**",
      "!assets/icon-v6.ico",
      "!node_modules/**/*.map",
      "!node_modules/js-yaml/bin/**",
      "!node_modules/argparse/**"
    ],
    "extraResources": [
      {
        "from": "GetTbBtn.exe",
        "to": "GetTbBtn.exe"
      }
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/kita18986342016/lyra-aria/releases/latest/download/"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon-v6.ico",
      "signAndEditExecutable": false,
      "electronLanguages": [
        "zh-CN",
        "en-US"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "深空折韵",
      "artifactName": "lyra-aria-setup-${version}.exe"
    },
    "asar": true,
    "asarUnpack": [
      "node_modules/koffi/**/*"
    ]
  }
}
